# ---------------------------------------------------------------------------
# Sodalis configuration. Copy to .env (repo root for local dev, docker/ for
# compose) and fill in. Every variable is validated in src/env.ts.
# ---------------------------------------------------------------------------

# --- Database --------------------------------------------------------------
DATABASE_URL=postgres://sodalis:sodalis@localhost:5432/sodalis
# Compose-only (docker/docker-compose.yml derives DATABASE_URL from these):
POSTGRES_USER=sodalis
POSTGRES_PASSWORD=change-me
POSTGRES_DB=sodalis
APP_PORT=3000

# --- Auth.js ---------------------------------------------------------------
# Generate with: openssl rand -base64 32
AUTH_SECRET=change-me
# External URL of the app as users reach it (needed behind a reverse proxy):
AUTH_URL=http://sodalis.corp.example.com

# --- SSO via OIDC (enabled when all three are set) -------------------------
# Register a confidential client at your IdP with redirect URI:
#   {AUTH_URL}/api/auth/callback/oidc
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Claim names vary per IdP; map them without code changes:
OIDC_CLAIM_DEPARTMENT=department
OIDC_CLAIM_OFFICE=office
# If set, membership of this group (in the "groups" claim) grants admin:
OIDC_ADMIN_GROUP=

# --- LDAP fallback (enabled when LDAP_URL + bind template are set) ---------
LDAP_URL=
# {username} is replaced with the login form input:
LDAP_BIND_DN_TEMPLATE=uid={username},ou=people,dc=corp,dc=example,dc=com
LDAP_ATTR_MAIL=mail
LDAP_ATTR_DISPLAY_NAME=displayName
LDAP_ATTR_DEPARTMENT=department
LDAP_ATTR_OFFICE=physicalDeliveryOfficeName

# --- Dev login (NEVER in production; ignored when NODE_ENV=production) -----
DEV_LOGIN_ENABLED=false

# --- Admin bootstrap -------------------------------------------------------
# Comma-separated emails granted admin on their next login:
ADMIN_EMAILS=admin@corp.example.com

# --- SMTP (notifications stay queued until configured) ---------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
SMTP_FROM=Sodalis <sodalis@corp.example.com>

# --- Scheduler -------------------------------------------------------------
# How long after signup close a missed match may still be triggered
# (worker downtime catch-up window), in hours:
MATCH_CATCH_UP_HOURS=3
